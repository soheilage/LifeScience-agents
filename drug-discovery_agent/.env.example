# Project configuration
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="true"

# Staging bucket for Agent Engine deployment
STAGING_BUCKET="gs://your-adk-staging-bucket"

# Vertex AI Model Garden TxGemma Endpoints
TXGEMMA_PREDICT_ENDPOINT_ID="your-txgemma-predict-endpoint-id"
TXGEMMA_PREDICT_LOCATION="us-central1"
TXGEMMA_CHAT_ENDPOINT_ID="your-txgemma-chat-endpoint-id"
TXGEMMA_CHAT_LOCATION="us-central1"

# NCBI PubMed API (Optional)
NCBI_API_KEY="your-ncbi-api-key"
