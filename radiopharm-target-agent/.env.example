# Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=

# Gemini Model Selection (PIN ONE - avoid preview models for determinism)
GEMINI_MODEL_ID=gemini-2.5-pro

# Specialized Vertex AI Endpoints (Enrichment models off critical path)
TXGEMMA_CHAT_ENDPOINT_ID=
TXGEMMA_PREDICT_ENDPOINT_ID=
TXGEMMA_PREDICT_LOCATION=us-central1
MEDGEMMA_ENDPOINT_ID=
MEDGEMMA_LOCATION=us-central1
CELL2SENTENCE_ENDPOINT_ID=

# NCBI Entrez Configuration (raises request limit from 3 to 10 req/s)
NCBI_API_KEY=
NCBI_EMAIL=radiopharm-agent@google.com

# Reference Dataset Versions
GTEX_RELEASE=v8
HPA_VERSION=v23.0
C2S_DATASET_ID=c2s_v1_curated
